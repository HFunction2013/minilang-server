{
  "name": "minilang-server",
  "version": "0.1.0",
  "description": "Language Server (LSP) for the minilang language, wrapping the minilang toolchain",
  "license": "MIT",
  "publisher": "minilang",
  "repository": {
    "type": "git",
    "url": "https://github.com/HFunction2013/minilang-server"
